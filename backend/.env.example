# Application
APP_NAME="Web Log Analyzer API"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_RELOAD=false

# Persistence
DATABASE_PATH="weblog_analyzer.db"

# CORS
# Pydantic Settings expects JSON for list values.
CORS_ORIGINS='["http://localhost:8501"]'
CORS_ALLOW_CREDENTIALS=true
CORS_METHODS='["GET","POST","PUT","DELETE","OPTIONS"]'
CORS_HEADERS='["Authorization","Content-Type"]'

# Mail
MAIL_ENABLED=false
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL=""
ALERT_EMAIL=""
