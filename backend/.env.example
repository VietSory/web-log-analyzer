# Application
APP_NAME="Web Log Analyzer API"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_RELOAD=false

# Persistence
DATABASE_PATH="weblog_analyzer.db"

# Uploads
UPLOAD_DIR="uploads"
UPLOAD_MAX_BYTES=10485760

# Machine learning
MODEL_DIR="models"

# Authentication
# Generate a production secret with: openssl rand -hex 32
AUTH_SECRET_KEY="dev-only-change-this-secret-at-least-32-bytes"
AUTH_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Abuse protection
# Process-local limiter; production replicas should enforce an additional shared edge limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
# Pydantic Settings expects JSON for list values.
CORS_ORIGINS='["http://localhost:8501"]'
CORS_ALLOW_CREDENTIALS=true
CORS_METHODS='["GET","POST","PUT","DELETE","OPTIONS"]'
CORS_HEADERS='["Authorization","Content-Type"]'

# Mail
MAIL_ENABLED=false
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL=""
ALERT_EMAIL=""
